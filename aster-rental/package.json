  "description": "Áster Rental — gestão de locadoras de máquinas, equipamentos e veículos integrada ao SAP Business One",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/src/server.js",
