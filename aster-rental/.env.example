# ---------- Servidor ----------
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# Banco interno (usuários, sessões, auditoria). No Docker fica no volume /app/data.
APP_DB_FILE=/app/data/aster-rental.db

# ---------- Segurança ----------
# Cookie só por HTTPS (obrigatório em produção).
COOKIE_SECURE=true
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# Domínios que podem exibir o sistema em iframe (o portal Áster) e chamar a API.
FRAME_ANCESTORS='self',https://aster.spsgroup.com.br
ALLOWED_ORIGINS=https://aster.spsgroup.com.br
# Administrador criado no primeiro início (troque a senha depois do primeiro acesso).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# ---------- SAP Business One ----------
# mock = demonstração com dados fictícios (proibido em produção); servicelayer = B1 real.
B1_MODE=servicelayer
B1_SL_URL=https://servidor-b1:50000/b1s/v1
B1_COMPANY_DB=SBO_EMPRESA
# Usuário técnico do B1 usado pelo backend (guarde em cofre de segredos).
B1_USER=
B1_PASSWORD=
# Certificado da Service Layer: caminho do CA quando for certificado interno.
B1_CA_FILE=
B1_TLS_VERIFY=true
B1_POOL_SIZE=4
B1_TIMEOUT_MS=60000
